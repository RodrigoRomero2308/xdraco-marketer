# Copia a .env y rellena. No subas .env al repositorio.
# WEMIX / APIs oficiales (si obtienes clave en docs.wemix.com)
# WEMIX_API_KEY=

# URLs base (por si cambian o quieres apuntar a testnet)
# WEMIX_PLAY_BASE_URL=https://wemixplay.com

# API MIR4 XDraco (pública; sin auth en la captura)
# XDRACO_API_BASE=https://webapi.mir4global.com
# Pausa entre requests (segundos) si te limitan
# XDRACO_DELAY=0.25
